# ============================================================
# RentBuddy 2026 — Root Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database (PostgreSQL) ---------------------------------
DATABASE_URL="postgresql://rentbuddy:password@localhost:5432/rentbuddy_dev?schema=public"

# ---- Redis -------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Firebase Admin SDK ------------------------------------
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"

# ---- Razorpay ----------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ---- LocationIQ --------------------------------------------
LOCATIONIQ_API_KEY="your_locationiq_api_key"

# ---- Server ------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ---- JWT (legacy fallback, prefer Firebase tokens) ---------
JWT_SECRET="a-very-long-random-secret-string-minimum-32-chars"

# ---- Admin Panel (Next.js) ---------------------------------
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"

# ---- Mobile (Expo) -----------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:5000/api"
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789:android:abcdef"
