# ============================================================
# RentBuddy 2026 — Root Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database (PostgreSQL) ---------------------------------
DATABASE_URL="postgresql://rentbuddy:password@localhost:5432/rentbuddy_dev?schema=public"

# ---- Redis -------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Firebase Admin SDK ------------------------------------
# Canonical project: "nabri-9b94d" (only project wired into this repo).
# Runtime reads the single-line JSON blob (firebase-admin). Generate a fresh
# private key: Firebase Console -> Project settings -> Service accounts ->
# Generate new private key, minify to one line. Do NOT reuse leaked keys -
# packages/backend/src/services/firebaseCredential.ts rejects them at startup.
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",\"project_id\":\"nabri-9b94d\",\"client_email\":\"firebase-adminsdk@nabri-9b94d.iam.gserviceaccount.com\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\nYOUR_NEW_KEY\\n-----END PRIVATE KEY-----\"}"

# ---- Cashfree: RETIRED, do not set -----------------------
# Money is collected manually against the platform UPI QR and credited once an
# admin verifies the UTR against the bank statement. Subscriptions come from the
# wallet when the balance covers the price, and fall back to the same UPI QR when
# it does not. Production starts fine without any of these; leaving them unset is
# what keeps online checkout off.
#
# The platform UPI VPA is not an env var either - it lives in the pricingConfig
# table under UPI_ID / UPI_ACCOUNT_NAME / UPI_QR_URL and is editable from the
# admin panel, so it can be corrected without a redeploy.

# ---- LocationIQ --------------------------------------------
LOCATIONIQ_API_KEY="your_locationiq_api_key"

# ---- Server ------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ---- JWT (legacy fallback, prefer Firebase tokens) ---------
JWT_SECRET="a-very-long-random-secret-string-minimum-32-chars"

# ---- Admin Panel (Next.js) ---------------------------------
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"

# ---- Mobile (Expo) -----------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:5000/api"
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789:android:abcdef"
