# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentbuddy?schema=public"

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Default admin (seeding)
ADMIN_EMAIL=admin@rentbuddy.app
ADMIN_PASSWORD=ChangeMe123!

# Razorpay Payment Gateway (Test Credentials for Development)
# Get your credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=webhook_secret_from_dashboard

# Payment Settings
PLATFORM_COMMISSION_PERCENT=10
MIN_BOOKING_AMOUNT=50
MAX_BOOKING_AMOUNT=10000
