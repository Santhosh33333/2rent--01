NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://rentbuddy:RentBuddy2026Dev@localhost:5432/rentbuddy?schema=public"

JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# Browser origins allowed to call the API, comma separated.
# In production this is ALSO the origin used to build post-payment return URLs,
# so it must be the real public web origin (e.g. https://2rent-01.vercel.app).
# Leaving it unset or loopback makes live payment order creation refuse to run
# rather than send a payer to localhost after they have paid.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20000
AUTH_RATE_LIMIT_MAX=20000

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

ADMIN_EMAIL=your_admin@example.com
ADMIN_PASSWORD=ChangeMe!
ADMIN_NAME=Admin

LOCATIONIQ_API_KEY=your_locationiq_api_key
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
LOCATIONIQ_TILE_URL=https://{s}.tile.locationiq.com/hot/{z}/{x}/{y}.png

# ---------------------------------------------------------------------------
# Movies (TMDB) - optional. Without a key the movies API reports
# MOVIES_NOT_CONFIGURED and the UI shows movie meetups only. It never fakes data.
#
# The catalogue is refreshed automatically at 00:00 IST every day, plus a
# top-up inside the day, so a film is on the shelf with its real poster and date
# BEFORE it opens rather than being fetched for the first time when someone
# looks for it.
# ---------------------------------------------------------------------------
# TMDB_API_KEY=your_tmdb_api_key

# Original languages to keep, in priority order, comma separated. Default "ta".
#
# Every query is filtered by ORIGINAL language, and `region` is not a substitute:
# region only changes release-date certification and poster language, which is
# how a Tamil cinema app ended up listing Resident Evil and Spider-Man.
#
# On the wire this becomes a PIPE list (`ta,en` -> `ta|en`). TMDB does not accept a
# comma here - it returns zero results with no error, so a typo looks exactly like
# "no films are listed". Set it empty to drop the filter and show every language.
# TMDB_LANGUAGES=ta

# How far back "now playing" reaches, in days. This is the setting that decides
# whether the shelf is honest - with no lower bound the query returns the most
# popular Indian film of all time and a 2021 release outranks one that opened
# this week. A theatrical run in India is roughly 4-6 weeks. Default 45.
# TMDB_NOW_PLAYING_WINDOW_DAYS=45

# How far ahead "coming soon" reaches, and how far the wider "upcoming" shelf
# goes. Defaults 7 and 120.
# TMDB_COMING_SOON_DAYS=7
# TMDB_UPCOMING_HORIZON_DAYS=120

# Feed freshness and sync cadence. Defaults 30 and 360.
# TMDB_CACHE_TTL_MINUTES=30
# TMDB_SYNC_INTERVAL_MINUTES=360

# Where "book tickets" sends people.
#
# There is deliberately no per-film link here. BookMyShow's per-film URLs need an
# internal EventCode that TMDB does not expose, and its search is a JavaScript
# modal with no addressable URL - which is why the old hardcoded
# `/search?q=<title>` link 404'd for every film. Point this at a real partner
# booking page if the business gets partner API access.
# TMDB_BOOKING_BASE_URL=https://in.bookmyshow.com/movies

# Clerk
CLERK_SECRET_KEY=sk_test_your_clerk_secret
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Cashfree - the only payment gateway.
# CASHFREE_SECRET_KEY also authenticates inbound webhooks, so production
# refuses to boot on a placeholder rather than trust unsigned callbacks.
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Keep in step with the keys above: "test" for sandbox, "production" for live.
CASHFREE_API_ENV=test

# Payment Settings
PLATFORM_COMMISSION_PERCENT=10
MIN_BOOKING_AMOUNT=50
MAX_BOOKING_AMOUNT=10000

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Required by env.ts Zod schema
JWT_SECRET=rentbuddy_jwt_secret_dev_32chars_minimum_2026

# Email provider: none | smtp | brevo | resend
# RECOMMENDED for production: brevo (Transaction Email API — api-key auth, works
# from any host). SMTP relay is bound to the sender IP (error 525 "Unauthorized
# IP address") and breaks on cloud hosts with rotating egress IPs, e.g. Render.
# Email (SMTP) — required for OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=RentBuddy <noreply@rentbuddy.app>

# Brevo Transactional Email API (preferred) — Brevo → SMTP & API → API Keys
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_FROM=Nabri <nabri.support@gmail.com>

# SMS provider: twilio | msg91 | none
# MSG91 free account: MSG91 → Settings → API Keys. India delivery may need a
# DLT-approved sender + template; free testing works on many accounts as-is.
SMS_PROVIDER=none
MSG91_AUTH_KEY=your_msg91_authkey
MSG91_SENDER_ID=NABRI

# Public OTP API (/api/otp/generate + /api/otp/verify): optional comma-separated
# spam keyword blocklist. Sensible defaults apply when empty/unset.
SPAM_BLOCK_WORDS=free money,bitcoin,casino,viagra,reward,download now,click here

# SMS (Twilio) — required for phone OTP
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Signup compliance: when true, accounts with BOTH email+phone must OTP-verify
# both channels before login (admins exempt). Keep false until SMS is live.
REQUIRE_DUAL_VERIFICATION=false

# SOS: optional ops phone (E.164) that also receives every SOS alert SMS.
SOS_SMS_TO=

# Public base URL the gateway calls back on (ngrok for local dev)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# Firebase (optional in dev - server works without real Firebase)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Redis (optional in dev - server works without Redis)
REDIS_URL=redis://localhost:6379

# AI gateway — free tiers only. All optional; without a key the LLM features
# honestly report AI_NOT_CONFIGURED and rules-based AI keeps working.
# Pick ONE of:
#   AI_PROVIDER=gemini  + AI_API_KEY (free key at aistudio.google.com/apikey)
#                       -> model defaults to gemini-3.8-flash (OpenAI-compatible
#                          endpoint; ~1,500 free requests/day, no card)
#   AI_PROVIDER=nim     + AI_API_KEY (free dev key at build.nvidia.com)
#                       -> model defaults to meta/muse-glimmer-30b (the open
#                          Meta model, served free by NVIDIA, 40 RPM; no card)
#   AI_PROVIDER=openai-compatible + AI_API_BASE + AI_API_KEY + AI_MODEL
# AI_PROVIDER=gemini
# AI_API_KEY=your_free_gemini_api_key
# AI_API_KEY=your_free_nvidia_nim_api_key
# AI_API_BASE=https://integrate.api.nvidia.com/v1
# AI_MODEL=meta/muse-glimmer-30b

# Groq (OpenAI-compatible, free tier at console.groq.com/keys).
# Model note, verified against a live account rather than assumed:
#   qwen/qwen3.8-27b  -> returns usable chat content
#   llama-3.3-70b-versatile -> HTTP 404 on Groq, do not use
#   openai/gpt-oss-* -> connects but returns empty content, do not use
# AI_PROVIDER=openai-compatible
# AI_API_BASE=https://api.groq.com/openai/v1
# AI_API_KEY=your_groq_api_key
# AI_MODEL=qwen/qwen3.8-27b
# Optional hard cap on LLM calls/user/hour (default 60). Rules-based AI is free.
# AI_USER_QUOTA_PER_HOUR=60

# ---------------------------------------------------------------------------
# Daily admin digest (midnight, role-scoped)
#
# Admin report emails. Seven cadences, each sent just after its period closes:
#
#   daily     every day at 00:00, covering the previous calendar day
#   weekly    Mondays at 00:00, covering the previous Monday-to-Sunday week
#   monthly   1st at 00:00, covering the previous calendar month
#   quarterly 1st of Jan/Apr/Jul/Oct at 00:00, covering the previous quarter
#   yearly    1st of January at 00:00, covering the previous calendar year
#   next-month 1st at 01:00, an outlook for the month ahead
#   tax       1st at 02:00, the tax bases for the previous month
#
# All times are server-local. Every delegated role receives only the sections it
# acts on: finance gets money, KYC gets verification, and so on. SUPER_ADMIN is the
# exception - it receives ONE combined mail carrying every section, which is why
# its recipients are read from the database when this variable is unset.
#
# Leaving a variable unset simply means that role is skipped - it is not an
# error, and the report for the other roles still sends.
#
# Comma separated. Set the ones you want:
# DIGEST_EMAIL_SUPER_ADMIN=owner@example.com
# DIGEST_EMAIL_FINANCE=finance@example.com
# DIGEST_EMAIL_KYC_ADMIN=kyc@example.com
# DIGEST_EMAIL_SUPPORT=support@example.com
# DIGEST_EMAIL_MODERATOR=mod@example.com
# DIGEST_EMAIL_MARKETING_ADMIN=marketing@example.com
# DIGEST_EMAIL_PARTNER_ADMIN=partners@example.com
#
# Which roles the standalone tax mail goes to. The tax figures are already inside
# the monthly, quarterly and yearly mail, so this only adds a separate
# tax-only copy for whoever files the return.
# TAX_REPORT_ROLES=SUPER_ADMIN,FINANCE_ADMIN,FINANCE
#
# Which roles get the CSV attachment. Default: SUPER_ADMIN, ADMIN, FINANCE,
# FINANCE_ADMIN.
# DIGEST_EXPORT_ROLES=SUPER_ADMIN,FINANCE
# ---------------------------------------------------------------------------