  id        String   @id @default(uuid())
  bookingId String
  fromStatus String?
  toStatus  String
  actorId    String?
  actorType String   @default("SYSTEM") // USER, PARTNER, SYSTEM, ADMIN
  note      String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model BookingTimeout {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  timeoutAt     DateTime
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([timeoutAt])
  @@index([isProcessed])
  @@index([isProcessed, timeoutAt])
}

model RefundLog {
  id               String   @id @default(uuid())
  bookingId        String?
  userId           String
  amount           Float
  reason           String
  type             String   // FULL, PARTIAL, AUTO_TIMEOUT
  cashfreeRefundId String?
  // Set for a wallet top-up refund. Null for the legacy booking refunds.
  // cashfreeRefundId is the idempotency key: Cashfree redelivers, and only the
  // first delivery may move money.
  paymentOrderId   String?
  status           String   @default("INITIATED") // INITIATED, PROCESSING, COMPLETED, FAILED
  initiatedBy      String   // SYSTEM, USER, PARTNER, ADMIN
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([paymentOrderId])
  @@index([cashfreeRefundId])
  // UNIQUE, not just indexed. This column is the idempotency latch for gateway
  // refunds, and idempotency only holds if the database rejects a second claim.
  // With a plain index, two concurrent deliveries both pass the existence check
  // and both proceed to move money; only the unique constraint makes one lose.
  // Nullable, so legacy rows without a gateway id are not collapsed together.
  @@unique([cashfreeRefundId])
}

