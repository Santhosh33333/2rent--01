generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id                             String    @id @default(uuid())
  clerkId                        String?   @unique
  email                          String    @unique
  phone                          String    @unique
  passwordHash                   String
  fullName                       String
  dateOfBirth                    DateTime
  gender                         String    @default("OTHER")
  avatarUrl                      String?
  bio                            String?
  city                           String?
  country                        String?
  /// Optional, one-time, self-supplied position used only to rank discovery
  /// results by distance. Never returned by any endpoint - discovery exposes an
  /// approximate distance band, not coordinates. Null simply means "distance is
  /// not rankable for this account", which is a supported state, not an error.
  latitude                       Float?
  longitude                      Float?
  status                         String    @default("ACTIVE")
  suspendedUntil                 DateTime?
  suspensionReason               String?
  role                           String    @default("USER")
  activeRole                     String?
  firebaseUid                    String?   @unique
  appleId                        String?   @unique
  emailVerified                  Boolean   @default(false)
  mobileVerified                 Boolean   @default(false)
language                      String    @default("en")
lastLoginAt                   DateTime?
  onboardingCompletedAt         DateTime?
  newUserUntil                  DateTime?
  // Local access window granted by a settled wallet top-up. Access is simply
  // "now < accessUntil", so it needs no provider round-trip and survives
  // Subscriptions being unavailable. accessSource records how it was granted
  // (TOPUP | SUBSCRIPTION | ADMIN) so an admin grant is distinguishable from
  // a payment. Null means no access.
  accessUntil                   DateTime?
  accessSource                  String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  verification                    Verification?
  walkingPartner                 WalkingPartner?
  partner                        Partner?
  wallet                         Wallet?
  preferences                    UserPreferences?
  loginHistory                   LoginHistory[]
  devices                        Device[]
  sessions                       Session[]
  notifications                  Notification[]
  trustScore                     TrustScore?
  referredBy                     Referral?            @relation("ReferredBy")
  referrals                      Referral[]           @relation("ReferralSender")
  applications                   RoleApplication[]
  bookings                       Booking[]            @relation("BookingUser")
  transactions                   Transaction[]
  communities                    CommunityMember[]    @relation("CommunityMembership")
  ownedCommunities               Community[]          @relation("CommunityOwner")
  communityPosts                 CommunityPost[]
  communityComments              CommunityComment[]
  posts                          Post[]
  postComments                   PostComment[]
  postLikes                      PostLike[]          @relation("FeedsPostLike")
  postSaves                      PostSave[]         @relation("FeedsPostSave")
  postReports                    PostReport[]       @relation("FeedsPostReport")
  giftsSent                      Gift[]             @relation("GiftSender")
  giftsReceived                  Gift[]             @relation("GiftRecipient")
  communityPolls                 CommunityPoll[]
  communityPollVotes             CommunityPollVote[]
  events                         Event[]              @relation("EventOrganizer")
  eventAttendances               EventAttendee[]      @relation("EventAttendeeUser")
  eventShares                    EventShare[]         @relation("EventShareUser")
  sentMessages                   Message[]            @relation("MessageSender")
  receivedMessages               Message[]            @relation("MessageReceiver")
  eventGroupMessages             EventGroupMessage[]  @relation("EventGroupSender")
  reportsFiled                   Report[]             @relation("ReportFiledBy")
  reportsAgainst                 Report[]             @relation("ReportAgainst")
  ratingsGiven                   Rating[]             @relation("RatingGivenBy")
  ratingsReceived                Rating[]             @relation("RatingReceivedBy")
  sosAlerts                      SosAlert[]
  blocksInitiated                UserBlock[]          @relation("BlockInitiator")
  blocksReceived                 UserBlock[]          @relation("BlockTarget")
  locationShares                 LocationShare[]
  auditLogs                      AuditLog[]
  withdrawalRequests             WithdrawalRequest[]
  agreements                     Agreement[]
  legalAcceptances               LegalAcceptance[]
  legalReConsent                 LegalReConsent?
  adminProfile                   AdminUser?
  partnerLevel                   PartnerLevel?
  partnerEarnings                PartnerEarnings?
  rewards                        Reward[]
  conversations1                 Conversation[]       @relation("ConversationP1")
  conversations2                 Conversation[]       @relation("ConversationP2")
  sentCalls                      CallLog[]            @relation("CallCaller")
  receivedCalls                  CallLog[]            @relation("CallReceiver")
  friendRequestsSent             Friendship[]         @relation("FriendRequester")
  friendRequestsReceived         Friendship[]         @relation("FriendAddressee")
  carryBuddyRequests             CarryBuddyRequest[]  @relation("CBRequester")
  carryBuddyAccepted             CarryBuddyRequest[]  @relation("CBAcceptedBy")
  walkingRequests                WalkingRequest[]     @relation("WalkingRequestRequester")
  acceptedWalks                  WalkingRequest[]     @relation("WalkAcceptedBy")
  completedWalks                 WalkingRequest[]     @relation("WalkCompletedBy")
  chatRequestsSent               ChatRequest[]        @relation("ChatReqSender")
  chatRequestsReceived           ChatRequest[]        @relation("ChatReqReceiver")
  chatRequestSettings            ChatRequestSettings?
  mutedUsers                     MuteList[]           @relation("MuteInitiator")
  mutedBy                        MuteList[]           @relation("MuteTarget")
  chatReportsFiled               ChatReport[]         @relation("ChatReportFiledBy")
  paymentOrders                  PaymentOrder[]
  creditLedgers                  CreditLedger[]
  topupRequests                  TopupRequest[]
  bankStatementsUploaded         BankStatement[]       @relation("BankStatementUploadedBy")
  bankStatementsApplied          BankStatement[]       @relation("BankStatementAppliedBy")
  bankStatementDecisions         BankStatementRow[]    @relation("BankStatementRowDecidedBy")
  // Event escrow: money staked on an event, and money owed for events this
  // account organized. Two separate relations because both sides point at User
  // and Prisma needs distinct names to disambiguate them.
  eventEscrowsPaid               EventEscrow[]         @relation("EventEscrowPayer")
  eventEscrowsEarned             EventEscrow[]         @relation("EventEscrowOrganizer")
  eventReportsFiled              EventReport[]         @relation("EventReportFiledBy")
  movieWatchlist                 MovieWatchlist[]
  supportTickets                 SupportTicket[]        @relation("SupportRequester")
  supportTicketsAssigned         SupportTicket[]        @relation("SupportAssignee")
supportMessages                SupportMessage[]

  likesGiven                     Like[]               @relation("LikeGiven")
  likesReceived                  Like[]               @relation("LikeReceived")
  passesGiven                    Pass[]               @relation("PassGiven")
  passesReceived                 Pass[]               @relation("PassReceived")
  matchesAsA                     Match[]              @relation("MatchUserA")
  matchesAsB                     Match[]              @relation("MatchUserB")
  subscriptions                  Subscription[]
  subscriptionPayments          SubscriptionPayment[]

  @@index([status])
  @@index([role])
  @@index([city])
  @@index([clerkId])
  /// Composite so discovery can narrow to a bounding box before scoring, rather
  /// than comparing every ACTIVE user row on latitude alone.
  @@index([latitude, longitude])
}

// ============================================================
// VERIFICATION
// ============================================================

model Verification {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  // Admin-granted trial: the user may use the app without completing KYC until
  // this instant, then the normal KYC gate applies again. Null (the default)
  // means no trial, so the gate behaves exactly as it did before this existed.
  // Stored on Verification rather than User because it is a property of the
  // KYC record, and requireKycVerified already reads that row.
  trialEndsAt              DateTime?
  personalDetails          Json?
  // The user's OWN mobile number, re-entered during KYC step 1 and required by
  // the backend to be the same number as User.phone.
  //
  // Why a column rather than another key inside `personalDetails`: this value is
  // compared server-side on every submission and is the audit record of what the
  // user declared about their identity. Buried in JSON it would be unqueryable,
  // and it would be silently rewritten every time step 1 was re-saved.
  //
  // Stored in the same E.164 form as User.phone (+91XXXXXXXXXX) so the comparison
  // is a plain string equality between two canonical values.
  confirmedPhone           String?
  selfieUrl                String?
  govIdUrl                 String?
  govIdType                String?
  addressProofUrl          String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactEmail    String?
  emergencyContactRelation String?
  status                   String    @default("NOT_STARTED") // NOT_STARTED, DRAFT, SUBMITTED, PENDING_REVIEW, UNDER_VERIFICATION, APPROVED, REJECTED, RESUBMIT_REQUIRED
  reviewedBy               String?
  reviewedAt               DateTime?
  rejectionReason          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history VerificationHistory[]

  @@index([status])
}

model VerificationHistory {
  id             String   @id @default(uuid())
  verificationId String
  status         String
  note           String?
  changedBy      String?
  createdAt      DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

// ============================================================
// ROLE APPLICATIONS
// ============================================================

model RoleApplication {
  id              String   @id @default(uuid())
  userId          String
  role            String
  status          String   @default("PENDING")
  data            String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([status])
}

// ============================================================
// WALKING PARTNER
// ============================================================

model WalkingPartner {
  id                String    @id @default(uuid())
  userId            String    @unique
  status            String    @default("NONE")
  rating            Decimal   @default(0) @db.Decimal(10, 2)
  totalWalks        Int       @default(0)
  totalEarnings     Decimal   @default(0) @db.Decimal(10, 2)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications WalkingRequestApplication[]

  @@index([status])
}

model WalkingRequest {
  id              String    @id @default(uuid())
  requesterId     String
  acceptedById    String?
  status          String    @default("OPEN")
  startLocation   String
  endLocation     String
  startTime       DateTime
  durationMinutes Int?
  notes           String?
  fare            Decimal?
  platformFee     Decimal?
  partnerEarning  Decimal?
  completedById   String?
  completedAt     DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requester     User                        @relation("WalkingRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  acceptedBy    User?                       @relation("WalkAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  completedBy   User?                       @relation("WalkCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  applications  WalkingRequestApplication[]
  earningDetails EarningDetail[]

  @@index([status])
  @@index([requesterId])
  @@index([acceptedById])
  @@index([completedById])
}

model WalkingRequestApplication {
  id          String   @id @default(uuid())
  requestId   String
  applicantId String
  status      String   @default("PENDING")
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request   WalkingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  applicant WalkingPartner @relation(fields: [applicantId], references: [userId], onDelete: Cascade)

  @@unique([requestId, applicantId])
  @@index([requestId])
}

model EarningDetail {
  id                  String   @id @default(uuid())
  earningsId          String
  walkingRequestId    String?
  bookingId           String?
  amount              Decimal
  type                String   @default("JOB_COMPLETION")
  description         String?
  platformFee         Decimal  @default(0)
  commissionDeduction Decimal  @default(0)
  incentive           Decimal  @default(0)
  bonus               Decimal  @default(0)
  netAmount           Decimal
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())

  earnings       PartnerEarnings @relation(fields: [earningsId], references: [id], onDelete: Cascade)
  walkingRequest WalkingRequest? @relation(fields: [walkingRequestId], references: [id])

  @@index([earningsId])
  @@index([bookingId])
  @@index([walkingRequestId])
  @@index([createdAt])
}

// ============================================================
// WALLETS & TRANSACTIONS
// ============================================================

model Wallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  balance           Decimal  @default(0) @db.Decimal(10, 2)
  promotionalBalance Decimal @default(0) @db.Decimal(10, 2)
  // Money reserved for something in progress (a metered call). NOT spendable:
  // available = balance - heldBalance. Introduced for prepaid call billing,
  // where the caller's balance must be committed up front so a call can never
  // outrun the funds behind it. Held funds are not a second balance and are not
  // counted as spendable anywhere else in the codebase.
  heldBalance       Decimal  @default(0) @db.Decimal(10, 2)
  currency          String   @default("INR")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  withdrawals   WithdrawalRequest[]
  paymentOrders PaymentOrder[]
  callCharges   CallCharge[]
  // No @@index([userId]) here: `userId` is already @unique, so it carries a
  // unique index. A second index on the same column is pure write overhead.
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  userId      String
  bookingId   String?
  type        String
  status      String   @default("COMPLETED")
  amount      Decimal
  description String?
  referenceId String?
  offerSnapshot Json?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([referenceId])
  @@index([createdAt])
}

model WithdrawalRequest {
  id              String    @id @default(uuid())
  userId          String
  walletId        String
  amount          Decimal
  status          String    @default("PENDING")
  method          String
  accountDetail   String?
  payoutProofImageUrl String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ============================================================
// AGREEMENTS (post-KYC safety/terms contracts)
// Status: PENDING -> SENT -> ACCEPTED. contentHtml is a snapshot of the
// template at the moment it was issued so later template edits never rewrite
// history. Acceptance is a legal record (acceptedAt timestamp).
// ============================================================
model Agreement {
  id          String    @id @default(uuid())
  userId      String
  kind        String    @default("USER") // USER | PARTNER
  title       String
  contentHtml String
  status      String    @default("PENDING") // PENDING | SENT | ACCEPTED
  sentAt      DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ============================================================================
// Published legal documents + signed acceptances.
//
// LegalDocument is the VERSIONED master copy of each policy. A new version is a
// new row (isCurrent=false on the old one) so an old acceptance always points at
// the exact wording the person actually signed, and a material change can
// require re-consent instead of silently rewriting history.
//
// LegalAcceptance is the binding record: who, which kind, which version, when,
// from which IP/device, what consent flow triggered it, and the signature
// itself. It is append-only by design — a correction is a new record, never an
// edit of an accepted one.
// ============================================================================

model LegalDocument {
  id            String    @id @default(uuid())
  kind          String // USER_AGREEMENT | PARTNER_AGREEMENT | PRIVACY_POLICY | COMMUNITY_GUIDELINES | BOOKING_POLICY
  version       Int
  title         String
  summary       String?
  contentHtml   String
  plainText     String
  effectiveFrom DateTime  @default(now())
  isCurrent     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  acceptances LegalAcceptance[]

  // One current row per kind; versions of the same kind are allowed.
  @@unique([kind, version])
  @@index([kind, isCurrent])
}

model LegalAcceptance {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  kind       String
  version    Int
  title      String
  // SIGNUP | PARTNER_ONBOARDING | BOOKING | RE_CONSENT
  consentType String  @default("SIGNUP")
  // TYPED_NAME | DRAWN
  signatureType String @default("TYPED_NAME")
  // Typed full name, or a data: URL for a drawn signature.
  signatureValue String
  // Hash of the exact document text that was signed, so tampering with the
  // stored HTML after acceptance is detectable.
  contentSha256  String
  ipAddress      String?
  userAgent      String?
  acceptedAt     DateTime @default(now())
  // Set when the person withdraws consent; the row is retained as evidence.
  withdrawnAt    DateTime?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument  @relation(fields: [documentId], references: [id])

  @@index([userId, kind])
  @@index([kind, version])
  @@index([userId, withdrawnAt])
}

// Accounts that predate consent enforcement hold no LegalAcceptance rows: they
// were created under a version of the product that never asked. Their consent
// is NOT reconstructed here, because a signature nobody gave is not consent and
// would poison an append-only evidence table. Instead this row records the
// moment each person was actually told, which is the only honest start point for
// a grace clock.
model LegalReConsent {
  userId String @id
  // When the person was first notified. The grace clock starts here, never at
  // deploy time, so nobody is locked out by a deadline they never saw.
  notifiedAt DateTime @default(now())
  graceDays Int @default(30)
  // Bumped each time a reminder goes out, so reminders stay idempotent and
  // auditable rather than firing on every page load.
  reminders Int @default(0)
  lastRemindedAt DateTime?
  satisfiedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([satisfiedAt])
  @@index([notifiedAt])
}

model SupportTicket {
  id String @id @default(uuid())
  // Human-facing id, e.g. NBR-7F3K2M. Users quote this in emails, so it must be
  // short, unambiguous and never expose the sequential uuid.
  reference    String    @unique
  requesterId  String
  category     String
  subject      String
  // OPEN | IN_PROGRESS | WAITING_ON_USER | RESOLVED | CLOSED
  status       String    @default("OPEN")
  // LOW | NORMAL | HIGH | URGENT
  priority     String    @default("NORMAL")
  assignedToId String?
  // What the ticket is about, when it points at something concrete (a booking, a
  // payment, a reported user). Kept loose so support can cover a report without
  // this table needing to know every entity type.
  relatedEntityType String?
  relatedEntityId   String?
  // Response tracking. firstResponseAt is the number that matters: it is how we
  // prove a service level was actually met rather than claiming it was.
  firstResponseAt DateTime?
  lastRepliedAt   DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requester  User  @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]
  events     SupportTicketEvent[]

  @@index([requesterId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model SupportMessage {
  id       String   @id @default(uuid())
  ticketId String
  authorId String
  body     String
  // Set from the author's role at write time, not from the request, so a
  // tampered client cannot claim to be staff on a public endpoint.
  isStaff  Boolean  @default(false)
  // Marks the message that closed the ticket, so the resolution is locatable.
  isResolution Boolean @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicketEvent {
  id        String   @id @default(uuid())
  ticketId  String
  actorId   String?
  action    String
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model PaymentOrder {
  id               String    @id @default(uuid())
  // Which gateway created this order. Cashfree is the only supported gateway;
  // the column is kept so a row records what actually settled it.
  provider         String    @default("cashfree") // cashfree
  cashfreeOrderId  String?   @unique
  cashfreePaymentId String?  @unique
  userId           String
  walletId         String
  amount           Decimal
  currency         String    @default("INR")
  status           String    @default("CREATED") // CREATED, AUTHORIZED, CAPTURED, COMPLETED, FAILED
  type             String    @default("TOPUP") // TOPUP, BOOKING
  metadata         String?
  completedAt      DateTime?
  // Refund bookkeeping. refundedAmount accumulates so partial refunds are
  // tracked without a second table; a full refund sets status to REFUNDED.
  refundedAmount   Decimal?
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// Manual UPI / QR payment collection (temporary flow for personal UPI accounts
// that are not an approved merchant gateway). The user pays the configured UPI
// QR externally, then submits the bank/UTR reference; an admin verifies it
// against the statement before the booking is confirmed. Never auto-confirm.
model UpiPayment {
  id               String   @id @default(uuid())
  bookingId        String
  userId           String
  amount           Decimal
  currency         String   @default("INR")
    referenceNumber  String?  @unique // UTR / bank reference; must be unique across bookings
    proofImageUrl    String? // payment screenshot uploaded by the user for manual verification
    status           String   @default("VERIFICATION_PENDING") // VERIFICATION_PENDING, VERIFIED, REJECTED, REQUEST_INFO
  verifiedByAdminId String?
  verificationNote String?
  metadata         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    @@index([status])
    @@index([bookingId])
    @@index([referenceNumber])
}

// Wallet top-up via manual UPI (no booking attached): user pays the
// platform QR externally, submits UTR + screenshot, admin verifies and
// the wallet is credited. Separate from booking-coupled UPI payments.
model TopupRequest {
  id                String   @id @default(uuid())
  userId            String
  amount            Decimal
  currency          String   @default("INR")
  referenceNumber   String   @unique // UTR; unique across top-ups AND UPI payments (checked in code)
  proofImageUrl     String?
  status            String   @default("VERIFICATION_PENDING") // VERIFICATION_PENDING, VERIFIED, REJECTED, REQUEST_INFO
  verifiedByAdminId String?
  verificationNote  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([referenceNumber])
}

// ============================================================
// DISCOVERY PREFERENCES
// ============================================================
//
// Discovery filters existed in the request layer (minAge/maxAge/gender/city on
// GET /dating/discover) but there was nowhere to store what a user actually
// wants. So every page had to send the filters explicitly, and DiscoverPage sent
// an empty object, which made the filters look broken while the backend was in
// fact behaving correctly for "no preferences expressed".
//
// UserPreferences is 1:1 with User rather than a row per setting because these
// values are read together on every discovery query and written together from
// one form. A key/value table would mean one query per preference and no way to
// make "save all" atomic.
//
// interests and languages are String[] because they are flat sets queried with
// overlap (&) and Postgres indexes arrays natively. lifestyle is a JSON object
// keyed by category ({activity:[...], food:[...]}) because its options only
// mean anything relative to their category - "vegetarian" is a food answer and
// "very social" is a social one, and a flat array could not tell you which.
//
// The defaults below are deliberately permissive (age 18-100, no interests, no
// languages) so a profile with no saved preferences still receives results.
// "No preferences" must never mean "no results".

model UserPreferences {
  userId String @id

  /// Discovery radius in km. 0 or the sentinel 100000 means "anywhere", which is
  /// why the UI offers an explicit Anywhere option rather than a huge number.
  distanceKm Int @default(50)

  ageMin Int @default(18)
  ageMax Int @default(100)

  /// Canonical lowercase values, never display labels. "travel" not "Travel",
  /// so a label rename in the admin panel cannot silently orphan saved data.
  interests String[] @default([])
  languages String[] @default([])

  /// {category: [value]} e.g. {"activity":["active"],"food":["vegetarian"]}
  lifestyle String @default("{}")

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The catalogue behind the preference UI, in the database rather than in the
// frontend, so an admin can add an interest or a lifestyle answer without a
// deploy. Without this the option list would be a hard-coded const on the client
// and every new option would need a release.
//
// Uniqueness includes category because lifestyle values are only unique within
// their category: "none" is a valid answer under Smoking, Drinking and Pets, and
// collapsing them into one row would make the UI show a single "None" chip in the
// wrong place.
model PreferenceOption {
  id String @id @default(uuid())

  /// INTEREST | LANGUAGE | LIFESTYLE
  kind String

  /// LIFESTYLE only: social | activity | schedule | food | pets | travel.
  /// Empty string for the flat kinds (INTEREST, LANGUAGE) rather than null.
  ///
  /// Non-nullable on purpose. Postgres treats NULLs as distinct inside a unique
  /// index, so a nullable category would let "travel" be inserted twice with two
  /// NULL categories and the uniqueness constraint would never fire - which is
  /// also exactly the column Prisma cannot build a compound-unique selector over,
  /// making the upsert impossible to express. A sentinel removes both problems.
  category String @default("")

  /// Canonical stored value. Lowercase, underscore-separated, stable across
  /// relabelling. This is what UserPreferences holds.
  value String

  /// What the user sees. Safe to change at any time.
  displayLabel String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, category, value])
  @@index([kind, isActive, sortOrder])
}

// ============================================================
// BANK STATEMENT RECONCILIATION
// ============================================================
//
// Manual UPI means a human reads a bank statement and types a verdict per
// request. That does not survive a busy evening: the queue grows, the credit
// gets late, and the admin starts approving from the screenshot alone.
//
// So the statement is uploaded instead, and each credit line is matched back to
// the request that claimed it - by UTR, and only when the amount agrees
// exactly. A statement is kept as its own row set rather than applied and
// discarded, because when an admin asks six weeks later "why did this person
// get credited twice", the answer has to be a query, not a memory.
//
// Two tables, and the split is deliberate: the statement is the upload (a file,
// a period, totals) and the row is the decision about one line of it. Rows
// outlive the verdict being interesting, so matchStatus is stored rather than
// recomputed on read.

model BankStatement {
  id       String @id @default(uuid())
  fileName String
  /// Bytes, kept so the admin can tell two same-named exports apart.
  byteSize Int    @default(0)
  /// sha256 of the file. Re-uploading the same export is a no-op rather than a
  /// second pass over lines that are already settled.
  fileHash String

  periodFrom DateTime?
  periodTo   DateTime?

  rowCount       Int @default(0)
  matchedCount   Int @default(0)
  creditedCount  Int @default(0)
  unmatchedCount Int @default(0)
  /// Money in the file that reconciliation declined to act on, for any reason.
  /// An admin should be able to see that this number is zero, and if it is not,
  /// that every rupee of it has a named row below.
  skippedAmount Decimal @default(0)

  /// UPLOADED -> PREVIEWED -> APPLIED. APPLIED is terminal and is what stops a
  /// second click from crediting the same line twice.
  status String @default("UPLOADED")

  /// Which CSV column carried which role, as JSON. Statements from different
  /// banks name the same column half a dozen ways, so the mapping is detected,
  /// shown to the admin, and stored with the result.
  columnMap String?
  /// Non-fatal parse problems (unknown column names, unparseable amounts) as a
  /// JSON array. Recorded instead of thrown: a bank export is not clean input,
  /// and refusing the whole file because six rows have odd dates would be worse
  /// than uploading it and flagging those six.
  warnings String?

  uploadedById String?
  appliedById  String?
  appliedAt    DateTime?
  createdAt    DateTime @default(now())

  uploadedBy User?           @relation("BankStatementUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  appliedBy  User?           @relation("BankStatementAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  rows       BankStatementRow[]

  @@unique([fileHash])
  @@index([status])
  @@index([createdAt])
}

model BankStatementRow {
  id          String @id @default(uuid())
  statementId String

  /// 1-based line in the file, so an admin reading the CSV can find the row
  /// without trusting the UI to have ordered it the same way.
  lineNo Int

  /// Exactly what the file said, kept verbatim. The normalised value is derived;
  /// when a match fails, the raw text is the only way to see why.
  rawReference String
  rawAmount    String?
  /// Reference as matched: trimmed, inner whitespace collapsed, upper-cased.
  referenceNorm String
  rawDate      String?

  amount  Decimal?
  txnDate DateTime?

  /// Whether this line is money coming in. A statement also lists the payouts
  /// and fees; crediting those would mint money. Only inbound lines are eligible.
  inbound Boolean @default(true)

  /// MATCHED | UNMATCHED | AMOUNT_MISMATCH | ALREADY_SETTLED | DUPLICATE_IN_FILE
  /// | NO_REFERENCE | UNPARSEABLE_AMOUNT
  matchStatus String @default("UNMATCHED")
  /// Human-readable explanation, shown next to the row.
  matchReason String?

  /// TOPUP | UPI_PAYMENT - which kind of request this line settled.
  matchedType   String?
  matchedId     String?
  matchedAmount Decimal?
  matchedUserId String?

  /// Set only once the wallet was actually moved. Distinct from matchStatus:
  /// a row can be MATCHED and still uncredited if the apply step failed.
  creditedAt   DateTime?
  creditedById String?

  // ---- A human's verdict on a line the matcher could not settle -------------
  //
  // Kept apart from `matchReason` on purpose. matchReason is a machine fact
  // ("no top-up claims this reference"); this is a human judgement, and it is
  // the only thing that makes a manually approved credit defensible when someone
  // asks about it months later. `service.recordRowDecision` refuses to write it
  // without a comment, because an unexplained approval in a money flow is
  // indistinguishable from a mistake.
  //
  // Null until an admin decides. A row with no decision and no match is what the
  // unmatched queue is built from.
  adminComment String?
  decidedById  String?
  decidedAt    DateTime?
  /// CREDITED | REJECTED | IGNORED - what the admin concluded, not the parser.
  decidedStatus String?

  /// The whole original row as JSON, for disputes.
  rawJson String?
  createdAt DateTime @default(now())

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  decidedBy  User?    @relation("BankStatementRowDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([statementId, matchStatus])
  @@index([referenceNorm])
  @@index([matchedType, matchedId])
  @@index([decidedById])
}

// ============================================================
// COMMUNITIES & EVENTS
// ============================================================

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatarUrl   String?
  privacy     String   @default("PUBLIC")
  ownerId     String
  city        String?
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  posts   CommunityPost[]
  polls   CommunityPoll[]

  @@index([privacy])
  @@index([city])
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("CommunityMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
}

model CommunityPost {
  id          String   @id @default(uuid())
  communityId String
  authorId    String
  content     String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  CommunityComment[]

  @@index([communityId, createdAt])
  @@index([authorId])
}

model CommunityComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model CommunityPoll {
  id          String    @id @default(uuid())
  communityId String
  authorId    String
  question    String
  closesAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  options   CommunityPollOption[]
  votes     CommunityPollVote[]

  @@index([communityId, createdAt])
}

model CommunityPollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String
  voteCount Int      @default(0)

  poll  CommunityPoll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes CommunityPollVote[]

  @@index([pollId])
}

model CommunityPollVote {
  id       String @id @default(uuid())
  pollId   String
  optionId String
  userId   String

  poll   CommunityPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

// ============================================================================
// EVENT CATEGORIES (admin-managed, DB-driven ordering)
// ============================================================================
// The category list used to be a hardcoded const in eventController. That made
// "reorder", "rename", "hide" and "add category" impossible without a code
// change and redeploy. Order, label, icon, visibility and subcategories are all
// rows now, so admin edits take effect immediately for every client.
//
// `key` is the stable slug stored on Event.category (a plain string, not an FK,
// so existing event rows and existing queries keep working unchanged). "All
// Events" is a pseudo-category and lives in the response, not in this table.
model EventCategory {
  id            String   @id @default(uuid())
  key           String   @unique
  label         String
  description   String?
  icon          String? // emoji or icon key, e.g. "🏃"
  coverImageUrl String?
  sortOrder     Int      @default(0)
  enabled       Boolean  @default(true) // shown in the user-facing filter list
  isVerifiedOnly Boolean @default(false) // category is itself curated
  subcategories String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model Event {
  id            String    @id @default(uuid())
  title         String
  description   String?
  organizerId   String
  // USER | PARTNER | COMMUNITY | ORGANIZER — lets the filter panel offer
  // "organized by a partner/community/verified organizer".
  organizerType String    @default("USER")
  communityId   String?
  location      String?
  // Coordinates power the Near Me / radius filter. Nullable because a lot of
  // events are online-only or listed without a map pin.
  latitude      Float?
  longitude     Float?
    isOnline         Boolean   @default(false)
    onlineUrl        String?
    // --- Movie outings -----------------------------------------------------
    // A cinema trip is an event like any other, but it needs three things the
    // generic fields cannot express. Deliberately minimal: the movie name IS
    // `title` and the showtime IS `startTime`, so adding a second copy of either
    // would create two sources of truth that can silently disagree.
    // isMovie drives the distinct creation flow and card treatment; the `movies`
    // category alone is not enough, because a category can be re-pointed or
    // typo'd and the movie layout would silently stop applying.
    isMovie          Boolean   @default(false)
    // The chosen cinema. Kept separate from `location` because the two answer
    // different questions: "where do I meet" is an address, "which screen" is a
    // venue, and a map pin cannot distinguish two branches of the same mall.
    theatreName      String?
    // Optional external checkout (a ticketing site, or a provider's ticket URL).
    // The event page offers in-app wallet purchase AND this link, so an organizer
    // is never forced to take payment through the platform.
    bookingUrl       String?
    // The one person added to the event who does NOT buy a seat: the point of
    // contact who confirms the group's ticket booking. Name + phone only, not a
    // User FK - the coordinator may not have a Nabri account, and forcing a
    // register+attendee row would contradict "added but not booking".
    coordinatorName  String?
    coordinatorPhone String?
  coverImageUrl String?
  category      String?
  subcategory   String?
  privacy       String    @default("PUBLIC") // PUBLIC, PRIVATE
  price         Float?
  currency      String    @default("INR")
  // OPEN until the organizer closes the collection. Distinct from the derived
  // "outstanding == 0", because an organizer may stop chasing the last person.
  paymentStatus String    @default("OPEN")
  paidAt        DateTime?
  // --- Escrow settlement ---------------------------------------------------
  // PENDING  nothing due yet (event has not finished)
  // IN_DISPUTE an open report froze the release
  // RELEASED  paid out to the organizer after the dispute window closed clean
  // REFUNDED  an admin found the event fake and paid everyone back
  // Separate from `paymentStatus`, which only means "collection closed".
  settlementStatus String    @default("PENDING")
  settledAt        DateTime?
  startTime     DateTime
  endTime       DateTime?
  timezone      String?
  capacity      Int?
  attendeeCount Int       @default(0)
  // Verified organizer events surface a trust badge in the UI.
  isVerified    Boolean   @default(false)
  womenOnly     Boolean   @default(false)
  status        String    @default("PUBLISHED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

    organizer User            @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
    attendees EventAttendee[]
  shares   EventShare[]
    groupMessages EventGroupMessage[]
    escrows EventEscrow[]
    reports EventReport[]

    @@index([organizerId])
    @@index([status, startTime])
    @@index([category])
    @@index([category, subcategory])
    // Discovery queries filter on (status, startTime) and sort on startTime;
    // endTime drives the "live now" window and capacity filters.
    @@index([status, endTime])
    @@index([privacy, startTime])
    @@index([createdAt])
    @@index([price])
    @@index([organizerType])
    @@index([latitude, longitude])
}

model EventShare {
  id        String    @id @default(uuid())
  eventId   String
  userId    String
  // What THIS attendee owes. Decimal, not Float: the per-person price is
  // advisory display data on `Event.price`, but the amount actually charged and
  // the amount already collected must not drift by a rounding error.
  amount    Decimal   @db.Decimal(12, 2)
  // PENDING | PAID | WAIVED
  status    String    @default("PENDING")
  // WALLET (paid inside the app) or UPI (paid to the organizer's UPI id
  // directly). A UPI payment is a claim until the organizer confirms it landed,
  // so it is never recorded as collected on the attendee's word alone.
  method    String    @default("WALLET")
  // The UPI transaction reference the payer quoted, for the organizer to match.
  methodRef String?
  // SELF, or the id of the person who covered this share on someone else's
  // behalf. Kept so "who actually paid" stays answerable after a group settle.
  paidBy    String?
  paidAt    DateTime?
  // Set when the organizer changes the per-person price after this share was
  // created, so the UI can show that the ask moved.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("EventShareUser", fields: [userId], references: [id], onDelete: Cascade)
  escrow EventEscrow?

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventAttendee {
  id          String    @id @default(uuid())
  eventId     String
  userId      String
  status      String    @default("REGISTERED")
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("EventAttendeeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

// ============================================================
// EVENT FEE ESCROW
//
// Why this exists: `payMyShare` used to debit the payer and stop there. The
// money left the wallet, a Transaction row recorded it, and NOTHING ever
// credited the organizer. There was no settle path at all, so an attendee's
// fee simply vanished. That is the bug this escrow exists to fix.
//
// `Wallet.heldBalance` already existed for prepaid call billing with exactly
// the semantics needed here: money stays in `balance` (the payer still owns it,
// so it stays visible and refundable) but is reserved and therefore not
// spendable, because available = balance - heldBalance. Reusing it rather than
// adding a second "escrow balance" keeps ONE definition of spendable money in
// the app instead of two that can disagree.
//
// A per-hold ledger row is still required, because `heldBalance` is a single
// number shared with call billing: without a row per hold there is no way to
// know which rupees to release on a refund, and a partial refund would free
// the wrong money.
// ============================================================

model EventEscrow {
  id      String @id @default(uuid())
  eventId String
  // One escrow per share. This unique index is also the idempotency guard: a
  // double tap or a retried request loses the insert race and settles once.
  eventShareId String @unique
  payerId      String
  organizerId  String
  amount       Decimal @db.Decimal(12, 2)
  // Platform cut, held back FROM the organizer's payout rather than added on
  // top, so the payer is never charged more than the share they were quoted.
  platformFee Decimal @default(0) @db.Decimal(12, 2)
  // amount - platformFee, denormalised so retuning the fee later cannot
  // retroactively change what an already-held payout was worth.
  organizerPayout Decimal @db.Decimal(12, 2)

  // HELD -> RELEASED (organizer paid)
  //       -> REFUNDED (payer made whole)
  //       -> DISPUTED (a report froze it; an admin then decides)
  status String @default("HELD")

  heldAt DateTime @default(now())
  // Event end + the dispute window, resolved to a fixed instant at hold time so
  // the deadline cannot drift when the constant is retuned for future events.
  releaseEligibleAt DateTime
  releasedAt        DateTime?
  refundedAt        DateTime?
  // Admin who made the call, plus a note the payer is shown by email. A
  // decision with no note is not permitted: "your money was returned" is not
  // an answer to "why did you take my money for an event that never happened".
  decidedById  String?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventShare EventShare @relation(fields: [eventShareId], references: [id], onDelete: Cascade)
  payer      User       @relation("EventEscrowPayer", fields: [payerId], references: [id], onDelete: Cascade)
  organizer  User       @relation("EventEscrowOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  // Reports that name this specific held fee.
  reports    EventReport[]

  @@index([eventId, status])
  @@index([payerId])
  @@index([organizerId])
  // The sweep that auto-releases unresolved escrows scans on exactly this pair.
  @@index([status, releaseEligibleAt])
}

// A report that an event was fake, misleading, or never happened.
//
// Separate from `Report`, which is user-against-user: its `target` is a User
// foreign key and cannot even name an event. This one freezes escrow, so it
// carries its own lifecycle and its own resolution fields.
model EventReport {
  id          String  @id @default(uuid())
  eventId     String
  reporterId  String
  // Optional: a payer disputing their own held fee. A report about the event as
  // a whole does not tie to one escrow.
  escrowId    String?
  // NO_SHOW | FAKE_EVENT | MISLEADING_DETAILS | UNSAFE | OTHER
  reason      String
  description String?
  // OPEN -> REFUNDED | RELEASED | DISMISSED
  status      String @default("OPEN")

  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporter User         @relation("EventReportFiledBy", fields: [reporterId], references: [id], onDelete: Cascade)
  escrow   EventEscrow? @relation(fields: [escrowId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([status])
  @@index([reporterId])
}

// ============================================================
// MESSAGING
// ============================================================

model Message {
  id             String   @id @default(uuid())
  senderId       String
  receiverId     String
  conversationId String
  content        String
  messageType    String   @default("TEXT")
  mediaUrl       String?
  bookingId      String?
  replyToId      String?
  reactions      Json?
  status         String   @default("SENT")
  clientId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([senderId, receiverId])
  @@index([senderId, clientId])
}

model Conversation {
  id            String    @id @default(uuid())
  participant1Id String
  participant2Id String
  lastMessageId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participant1 User          @relation("ConversationP1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User          @relation("ConversationP2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]
  typingStatus TypingStatus[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

// An event's group thread: everyone RSVP'd to the event talking to each other.
//
// Deliberately NOT a Conversation. That model is strictly two-party
// (participant1/participant2 with a unique pair), and retrofitting group chat
// onto it would mean auditing every 1:1 query, unread count and socket fan-out
// in the messenger. An event thread has a different membership rule too:
// access comes from the event's attendee list, not from an invitation.
model EventGroupMessage {
  id        String   @id @default(uuid())
  eventId   String
  senderId  String
  content   String
  messageType String @default("TEXT") // TEXT | IMAGE
  mediaUrl  String?
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender User  @relation("EventGroupSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model TypingStatus {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  isTyping       Boolean  @default(false)
  lastTypedAt    DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model CallLog {
  id         String   @id @default(uuid())
  callerId   String
  receiverId String
  type       String   @default("VOICE")
  status     String   @default("MISSED")
  startedAt  DateTime?
  endedAt    DateTime?
  duration   Int?
  createdAt  DateTime @default(now())

  caller   User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // 1:1 billing record for this call. Absent on calls that were never
  // connected, or connected while billing was disabled.
  charge CallCharge?

  @@index([callerId])
  @@index([receiverId])
  @@index([status, startedAt])
}

/// Money record for one connected call. One row per call, created when the
/// call is answered and settled exactly once when it ends.
///
/// The money model is a hold/capture pair, not a post-hoc debit:
///   - hold     = rate x maxBillableMinutes, taken from Wallet.heldBalance at
///                answer time, so a call can never outrun the caller's funds
///   - charged  = rate x actual billable minutes, taken from balance on end
///   - heldAmount - charged is returned to the available balance
///
/// `status` guards settlement: only a HELD row may be captured or released,
/// and the transition is a guarded updateMany, so a duplicate end event (hangup
/// racing a disconnect) cannot double-charge or double-refund.
model CallCharge {
  id          String   @id @default(uuid())
  callId      String   @unique
  callerId    String
  receiverId  String
  walletId    String

  ratePerMinute Decimal @db.Decimal(10, 2)
  heldAmount    Decimal @db.Decimal(10, 2)
  chargedAmount Decimal @default(0) @db.Decimal(10, 2)
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  // HELD -> CHARGED (funds captured) or RELEASED (call ended, nothing captured).
  status String @default("HELD")

  /// Server-computed seconds actually billed. Derived from server timestamps
  /// only, never from anything the client reports.
  billableSeconds Int      @default(0)
  startedAt        DateTime
  endedAt          DateTime?
  /// Why settlement stopped early, when it was not a clean hangup: CLIENT_END,
  /// PEER_END, MAX_DURATION, INSUFFICIENT_FUNDS, ADMIN_REVERSAL, ABANDONED.
  endReason        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  call    CallLog @relation(fields: [callId], references: [id], onDelete: Cascade)
  wallet  Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([status])
  @@index([walletId])
}

