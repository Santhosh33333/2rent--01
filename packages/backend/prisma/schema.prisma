  targetType String
  targetId   String
  authorId   String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model UserActivity {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorType  String
  action     String
  entityType String?
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model SosIncident {
  id          String    @id @default(uuid())
  userId      String
  latitude    Float?
  longitude   Float?
  address     String?
  message     String?
  severity    String    @default("HIGH")
  status      String    @default("ACTIVE")
  respondedBy String?
  respondedAt DateTime?
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

model BlocklistEntry {
  id        String    @id @default(uuid())
  type      String
  value     String
  reason    String?
  addedBy   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([type, value])
}

model MaintenanceWindow {
  id               String   @id @default(uuid())
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  affectedServices String
  isActive         Boolean  @default(false)
  createdBy        String?
  createdAt        DateTime @default(now())
}

model AppVersion {
  id            String   @id @default(uuid())
  platform      String
  version       String
  buildNumber   Int
  isForceUpdate Boolean  @default(false)
  releaseNotes  String?
  isActive      Boolean  @default(true)
  releasedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ============================================================
// UNIFIED PARTNER & BOOKING SYSTEM
// ============================================================

model Partner {
  dispatchRequests  DispatchRequest[]
  id                String    @id @default(uuid())
  userId            String    @unique
  status            String    @default("NONE") // NONE, APPLIED, APPROVED, REJECTED
  providesWalking   Boolean   @default(false)
  providesCarry     Boolean   @default(false)
  rating            Float     @default(0)
  totalJobs         Int       @default(0)
  totalEarnings     Float     @default(0)
  completedJobs     Int       @default(0)
  cancelledJobs     Int       @default(0)
  averageRating     Float     @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  latitude          Float?
  longitude         Float?
  isAvailable       Boolean   @default(true)
  availabilityJson  String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("BookingPartner")

  @@index([status])
  @@index([isAvailable])
  @@index([providesWalking, providesCarry])
}

model Booking {
  dispatchRequests  DispatchRequest[]
  id                String    @id @default(uuid())
  userId            String
  partnerId         String?
  serviceType       String    // WALKING, CARRY_BUDDY
  status            String    @default("PAYMENT_PENDING")
  // PAYMENT_PENDING, PAYMENT_INITIATED, PAYMENT_SUCCESSFUL, PARTNER_SEARCHING, PARTNER_ASSIGNED,
  // PARTNER_ACCEPTED, OTP_GENERATED, IN_PROGRESS, COMPLETED, CANCELLED, REFUND_INITIATED, REFUND_COMPLETED

  // Location
  startLocation     String
  endLocation       String
  startLatitude     Float?
  startLongitude    Float?
  endLatitude       Float?
  endLongitude      Float?

  // Scheduling
  scheduledAt       DateTime
  durationMinutes   Int?
  startedAt         DateTime?
  completedAt       DateTime?

  // CarryBuddy-specific
  itemType          String?
  itemDescription   String?

  // Pricing
  estimatedAmount   Float?
  finalAmount       Float?
  platformFee       Float?
  partnerEarning    Float?
  couponCode        String?
  discountAmount    Float?

  // Pricing snapshot (frozen at booking creation so later admin config changes
  // never alter an already-confirmed booking's amount).
  pricingVersion    Int?
  pricingSnapshot   Json?

  // Payment
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentStatus     String    @default("PENDING") // PENDING, INITIATED, PAID, FAILED
  paymentVerifiedAt DateTime?

  // OTP
  otp               String?
  otpGeneratedAt    DateTime?
  otpVerifiedAt     DateTime?

  // Cancellation
  cancelledBy       String?
  cancelReason      String?
  cancelledAt       DateTime?

  // Refund
  refundStatus      String?   // NONE, REFUND_INITIATED, REFUND_COMPLETED
  refundAmount      Float?
  refundId          String?
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?

  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  partner Partner? @relation("BookingPartner", fields: [partnerId], references: [id])
  timeout BookingTimeout?
  logs    BookingLog[]

  @@index([status])
  @@index([userId])
  @@index([partnerId])
  @@index([serviceType])
  @@index([scheduledAt])
}

model BookingLog {
  id        String   @id @default(uuid())
  bookingId String
  fromStatus String?
  toStatus  String
  actorId    String?
  actorType String   @default("SYSTEM") // USER, PARTNER, SYSTEM, ADMIN
  note      String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model BookingTimeout {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  timeoutAt     DateTime
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([timeoutAt])
  @@index([isProcessed])
}

model RefundLog {
  id               String   @id @default(uuid())
  bookingId        String
  userId           String
  amount           Float
  reason           String
  type             String   // FULL, PARTIAL, AUTO_TIMEOUT
  razorpayRefundId String?
  status           String   @default("INITIATED") // INITIATED, PROCESSING, COMPLETED, FAILED
  initiatedBy      String   // SYSTEM, USER, PARTNER, ADMIN
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
  @@index([status])
}

model PartnerLocation {
  id        String   @id @default(uuid())
  partnerId String   @unique
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  updatedAt DateTime @default(now())

  @@index([partnerId])
}

model DispatchRequest {
  id          String    @id @default(uuid())
  bookingId   String
  partnerId   String
  status      String    @default("SENT") // SENT, VIEWED, ACCEPTED, EXPIRED, REJECTED, CANCELLED
  sentAt      DateTime  @default(now())
  viewedAt    DateTime?
  respondedAt DateTime?
  expiresAt   DateTime

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, partnerId])
  @@index([bookingId])
  @@index([partnerId, status])
}

