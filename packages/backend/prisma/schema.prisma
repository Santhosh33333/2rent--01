// ============================================================
// SUBSCRIPTIONS
// Prices are admin-configurable here, never hardcoded in the
// frontend. Replaces the legacy one-off booking payment model.
// ============================================================

model SubscriptionPlan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  /// What a subscriber pays for a period once any intro pricing is over.
  price         Float
  /// The struck-through "was" price on the pricing screen. Null means no offer
  /// is advertised for this plan - the honest default until an admin sets one,
  /// because a discount the product cannot grant must not be drawn.
  listPrice     Float?
  /// First-period price for an account that has never held a subscription.
  /// Null disables the new-user offer entirely; renewals never see it, because
  /// a renewal is by definition no longer a first period.
  offerPrice    Float?
  currency      String   @default("INR")
  durationDays  Int
  trialDays     Int      @default(0)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  // Cashfree plan_id once mirrored to the gateway; null until then.
  gatewayPlanId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@index([isActive, displayOrder])
}

model Subscription {
  id                   String    @id @default(uuid())
  subscriptionId       String    @unique
  userId               String
  planId               String
  // INITIALIZED | PENDING | ACTIVE | PAST_DUE | ON_HOLD | PAUSED
  // | CUSTOMER_PAUSED | COMPLETED | CUSTOMER_CANCELLED | EXPIRED | CANCELLED
  status               String    @default("INITIALIZED")
  // INITIALIZED | PENDING | SUCCESS | FAILED
  authorizationStatus  String    @default("PENDING")
  // Whether the renewal sweeper should try to collect at nextBillingAt. False
  // means the plan lapses there instead of being charged, so nobody is ever
  // billed by surprise after deciding not to auto-renew.
  autoRenew            Boolean   @default(true)
  // The date the current collection attempt failed to collect. Kept separate
  // from status so the admin queue can show what is owed and since when.
  pastDueAt            DateTime?
  trialEndsAt          DateTime?
  nextBillingAt        DateTime?
  startedAt            DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  // The manual-UPI collection requests raised against this subscription. One
  // live row at a time; a renewal replaces the previous attempt's row.
  payment SubscriptionPayment?

  @@index([userId, status])
  @@index([status, nextBillingAt])
  @@index([autoRenew, status, nextBillingAt])
}

/// A manual-UPI collection request for a subscription.
///
/// There is no gateway mandate any more, so a plan is paid for from the wallet
/// when the balance covers it and otherwise by paying the platform QR
/// externally. This row is that second path: it holds the amount owed for one
/// billing period until an admin verifies the UTR, and only then does the plan
/// activate. Deliberately NOT a TopupRequest - that credits a wallet, whereas
/// this money buys the plan period itself and is never spendable balance.
model SubscriptionPayment {
  id             String  @id @default(uuid())
  subscriptionId String  @unique
  userId         String
  planId         String
  amount         Decimal @db.Decimal(10, 2)
  currency       String  @default("INR")
  /// The period this payment buys. Retained after settlement so a renewal can
  /// never be mistaken for the purchase that preceded it.
  periodStart    DateTime
  periodEnd      DateTime
  /// UTR / bank reference. Unique, and checked in code against TopupRequest and
  /// UpiPayment too, so one bank line can never settle two requests.
  referenceNumber String? @unique
  proofImageUrl   String?
  status          String  @default("VERIFICATION_PENDING")
  verifiedByAdminId String?
  verificationNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Denormalised from the subscription so the admin queue can name the plan
  // without a second query, and so the row still says what it paid for after the
  // plan is renamed.
  plan         SubscriptionPlan  @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([userId])
  // No index on planId: nothing filters by plan. The admin queue filters by
  // status, and the user-facing lookup is by subscriptionId, which already
  // carries a unique index.
}


// ============================================================
// ADMIN REPORT RUN MARKERS
// ============================================================
//
// One row per report period that has been claimed for sending. Exists so a report
// cannot go out twice for the same period.
//
// The seven report cadences (daily, weekly, monthly, quarterly, yearly,
// next-month, tax) used to be guarded by an in-process Set. That is enough for a
// single instance and useless for the real deployment: the process restarts on
// every deploy and Render runs more than one instance, so a deploy landing inside
// the one-hour send window sent that day's digest a second time, and two
// instances reaching the same midnight each sent their own copy.
//
// The guard is the unique constraint on (period, windowKey), not a read-then-
// write. A SELECT followed by an INSERT is a race by construction - both
// instances can read "not sent" and both insert. Making the INSERT itself the
// claim means the database arbitrates, and the loser is told so by a constraint
// violation rather than by a hopeful check.
//
// `windowKey` is the period's own identity (its start and end boundaries), not
// the calendar date the run happened on, so a manual re-run for the same period
// is recognised as a duplicate rather than treated as new.
model DigestRun {
  id        String   @id @default(uuid())
  period    String
  windowKey String
  // When the claim was made. Kept for the prune below, not for reporting: the
  // row is a lock, not a record of a successful send. A claim that then fails to
  // send still consumes its period, which is deliberate - a partial report is
  // better than a duplicate one.
  claimedAt DateTime @default(now())

  @@unique([period, windowKey])
  @@index([claimedAt])
}

// ============================================================
// WEBSITE ENQUIRY FORMS — beta tester, app feedback, investor
// ============================================================

// Every reply submitted from the landing-page forms. The page still posts
// normally to formsubmit.co, so the founder's mailbox keeps receiving each
// reply as it always did; the browser mirrors the same answers here. That
// second copy is the whole point - a mailbox cannot be sorted, filtered or
// exported, so "show me every reply in one sheet" needs rows to read from.
model FormSubmission {
  id        String   @id @default(uuid())
  // The hidden "Form" field the page posts: "Beta tester", "App feedback" or
  // "Investor or supporter".
  form      String
  // The _subject line the page would have emailed, kept so an exported row
  // reads like the message it came from.
  subject   String
  name      String?
  email     String
  // Flat name -> value map of every other answer. JSON rather than columns
  // because the three forms ask different questions and a fourth form should
  // not need a migration to be recorded.
  fields    Json
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  // When the beta-tester invitation email was delivered to this address.
  // Null means "not yet invited". Set on every row for the address after a
  // successful send, so the backfill and the live capture path never mail the
  // same person twice. Non-beta replies always leave it null.
  invitedAt DateTime?

  @@index([form, createdAt])
  @@index([createdAt])
  @@index([email])
}