model Partner {
  dispatchRequests  DispatchRequest[]
  id                String    @id @default(uuid())
  userId            String    @unique
  status            String    @default("NONE") // NONE, APPLIED, APPROVED, REJECTED
  providesWalking   Boolean   @default(false)
  providesCarry     Boolean   @default(false)
  rating            Float     @default(0)
  totalJobs         Int       @default(0)
  totalEarnings     Float     @default(0)
  completedJobs     Int       @default(0)
  cancelledJobs     Int       @default(0)
  averageRating     Float     @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  latitude          Float?
  longitude         Float?
  isAvailable       Boolean   @default(true)
  availabilityJson  String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("BookingPartner")

  @@index([status])
  @@index([isAvailable])
  @@index([providesWalking, providesCarry])
}

model Booking {
  dispatchRequests  DispatchRequest[]
  id                String    @id @default(uuid())
  userId            String
  partnerId         String?
  serviceType       String    // WALKING, CARRY_BUDDY
  status            String    @default("PAYMENT_PENDING")
  // PAYMENT_PENDING, PAYMENT_INITIATED, PAYMENT_SUCCESSFUL, PARTNER_SEARCHING, PARTNER_ASSIGNED,
  // PARTNER_ACCEPTED, OTP_GENERATED, IN_PROGRESS, COMPLETED, CANCELLED, REFUND_INITIATED, REFUND_COMPLETED

  // Location
  startLocation     String
  endLocation       String
  startLatitude     Float?
  startLongitude    Float?
  endLatitude       Float?
  endLongitude      Float?

  // Scheduling
  scheduledAt       DateTime
  durationMinutes   Int?
  startedAt         DateTime?
  completedAt       DateTime?

  // CarryBuddy-specific
  itemType          String?
  itemDescription   String?

  // Pricing
  estimatedAmount   Float?
  finalAmount       Float?
  platformFee       Float?
  partnerEarning    Float?
  couponCode        String?
  discountAmount    Float?

  // Pricing snapshot (frozen at booking creation so later admin config changes
  // never alter an already-confirmed booking's amount).
  pricingVersion    Int?
  pricingSnapshot   Json?

  // Offer snapshot (frozen at booking creation so a later offer change never
  // alters an already-confirmed transaction).
  offerSnapshot     Json?
  offerCode         String?

  // Payment
  paymentProvider   String?   // cashfree
  cashfreeOrderId   String?
  cashfreePaymentId String?
  paymentStatus     String    @default("PENDING") // PENDING, INITIATED, PAID, FAILED, VERIFICATION_PENDING, REJECTED
  paymentMethod     String?   @default("ONLINE") // ONLINE, CASH, UPI_MANUAL
  paymentVerifiedAt DateTime?

  // OTP
  otp               String?
  otpGeneratedAt    DateTime?
  otpVerifiedAt     DateTime?

  // Cancellation
  cancelledBy       String?
  cancelReason      String?
  cancelledAt       DateTime?

  // Refund
  refundStatus      String?   // NONE, REFUND_INITIATED, REFUND_COMPLETED
  refundAmount      Float?
  refundId          String?
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?

  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  partner Partner? @relation("BookingPartner", fields: [partnerId], references: [id])
  upiPayments UpiPayment[]
  timeout BookingTimeout?
  logs    BookingLog[]

  @@index([status])
  @@index([userId])
  @@index([partnerId])
  @@index([serviceType])
  @@index([userId, status])
  @@index([partnerId, status])
  @@index([status, scheduledAt])
  @@index([scheduledAt])
}

