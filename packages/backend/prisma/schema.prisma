model BlocklistEntry {
  id        String    @id @default(uuid())
  type      String
  value     String
  reason    String?
  addedBy   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([type, value])
}

model MaintenanceWindow {
  id               String   @id @default(uuid())
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  affectedServices String
  isActive         Boolean  @default(false)
  createdBy        String?
  createdAt        DateTime @default(now())
}

model AppVersion {
  id            String   @id @default(uuid())
  platform      String
  version       String
  buildNumber   Int
  isForceUpdate Boolean  @default(false)
  releaseNotes  String?
  isActive      Boolean  @default(true)
  releasedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ============================================================
// UNIFIED PARTNER & BOOKING SYSTEM
// ============================================================

model Partner {
  dispatchRequests  DispatchRequest[]
  id                String    @id @default(uuid())
  userId            String    @unique
  status            String    @default("NONE") // NONE, APPLIED, APPROVED, REJECTED
  providesWalking   Boolean   @default(false)
  providesCarry     Boolean   @default(false)
  rating            Float     @default(0)
  totalJobs         Int       @default(0)
  totalEarnings     Float     @default(0)
  completedJobs     Int       @default(0)
  cancelledJobs     Int       @default(0)
  averageRating     Float     @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  latitude          Float?
  longitude         Float?
  isAvailable       Boolean   @default(true)
  availabilityJson  String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("BookingPartner")

  @@index([status])
  @@index([isAvailable])
  @@index([providesWalking, providesCarry])
}

model Booking {
  dispatchRequests  DispatchRequest[]
  id                String    @id @default(uuid())
  userId            String
  partnerId         String?
  serviceType       String    // WALKING, CARRY_BUDDY
  status            String    @default("PAYMENT_PENDING")
  // PAYMENT_PENDING, PAYMENT_INITIATED, PAYMENT_SUCCESSFUL, PARTNER_SEARCHING, PARTNER_ASSIGNED,
  // PARTNER_ACCEPTED, OTP_GENERATED, IN_PROGRESS, COMPLETED, CANCELLED, REFUND_INITIATED, REFUND_COMPLETED

  // Location
  startLocation     String
  endLocation       String
  startLatitude     Float?
  startLongitude    Float?
  endLatitude       Float?
  endLongitude      Float?

  // Scheduling
  scheduledAt       DateTime
  durationMinutes   Int?
  startedAt         DateTime?
  completedAt       DateTime?

  // CarryBuddy-specific
  itemType          String?
  itemDescription   String?

  // Pricing
  estimatedAmount   Float?
  finalAmount       Float?
  platformFee       Float?
  partnerEarning    Float?
  couponCode        String?
  discountAmount    Float?

  // Pricing snapshot (frozen at booking creation so later admin config changes
  // never alter an already-confirmed booking's amount).
  pricingVersion    Int?
  pricingSnapshot   Json?

  // Offer snapshot (frozen at booking creation so a later offer change never
  // alters an already-confirmed transaction).
  offerSnapshot     Json?
  offerCode         String?

  // Payment
  paymentProvider   String?   // cashfree
  cashfreeOrderId   String?
  cashfreePaymentId String?
  paymentStatus     String    @default("PENDING") // PENDING, INITIATED, PAID, FAILED, VERIFICATION_PENDING, REJECTED
  paymentMethod     String?   @default("ONLINE") // ONLINE, CASH, UPI_MANUAL
  paymentVerifiedAt DateTime?

  // OTP
  otp               String?
  otpGeneratedAt    DateTime?
  otpVerifiedAt     DateTime?

  // Cancellation
  cancelledBy       String?
  cancelReason      String?
  cancelledAt       DateTime?

  // Refund
  refundStatus      String?   // NONE, REFUND_INITIATED, REFUND_COMPLETED
  refundAmount      Float?
  refundId          String?
  refundInitiatedAt DateTime?
  refundCompletedAt DateTime?

  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user    User     @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  partner Partner? @relation("BookingPartner", fields: [partnerId], references: [id])
  upiPayments UpiPayment[]
  timeout BookingTimeout?
  logs    BookingLog[]

  @@index([status])
  @@index([userId])
  @@index([partnerId])
  @@index([serviceType])
  @@index([userId, status])
  @@index([partnerId, status])
  @@index([status, scheduledAt])
  @@index([scheduledAt])
}

model BookingLog {
  id        String   @id @default(uuid())
  bookingId String
  fromStatus String?
  toStatus  String
  actorId    String?
  actorType String   @default("SYSTEM") // USER, PARTNER, SYSTEM, ADMIN
  note      String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model BookingTimeout {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  timeoutAt     DateTime
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([timeoutAt])
  @@index([isProcessed])
  @@index([isProcessed, timeoutAt])
}

model RefundLog {
  id               String   @id @default(uuid())
  bookingId        String?
  userId           String
  amount           Float
  reason           String
  type             String   // FULL, PARTIAL, AUTO_TIMEOUT
  cashfreeRefundId String?
  // Set for a wallet top-up refund. Null for the legacy booking refunds.
  // cashfreeRefundId is the idempotency key: Cashfree redelivers, and only the
  // first delivery may move money.
  paymentOrderId   String?
  status           String   @default("INITIATED") // INITIATED, PROCESSING, COMPLETED, FAILED
  initiatedBy      String   // SYSTEM, USER, PARTNER, ADMIN
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([paymentOrderId])
  @@index([cashfreeRefundId])
}

model PartnerLocation {
  id        String   @id @default(uuid())
  partnerId String   @unique
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  updatedAt DateTime @default(now())

  @@index([partnerId])
}

model DispatchRequest {
  id          String    @id @default(uuid())
  bookingId   String
  partnerId   String
  status      String    @default("SENT") // SENT, VIEWED, ACCEPTED, EXPIRED, REJECTED, CANCELLED
  sentAt      DateTime  @default(now())
  viewedAt    DateTime?
  respondedAt DateTime?
  expiresAt   DateTime

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, partnerId])
  @@index([bookingId])
  @@index([partnerId, status])
}

// ============================================================
// ADMIN RBAC — PROMOTIONAL CREDIT LEDGER (spec sections 9-13)
// ============================================================

model CreditLedger {
  id          String   @id @default(uuid())
  userId      String
  adminId     String
  type        String // PROMOTIONAL_CREDIT, PROMOTIONAL_DEBIT, EXPIRATION, REVERSAL, ADJUSTMENT
  creditType  String?  // PROMOTIONAL_CREDIT, COMPENSATION, REFERRAL_BONUS, etc.
  amount      Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal @db.Decimal(10, 2)
  reason      String?
  referenceId String?  // bookingId / paymentId / withdrawalId this credit paid for
  expiresAt   DateTime?
  status      String   @default("COMPLETED") // PENDING, COMPLETED, REVERSED, EXPIRED
  metadata    String?
  createdAt   DateTime @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
}

// Promotional-credit policy knobs (spec section 12). Stored as rows so a
// marketing/finance admin can reconfigure without a deploy.
model CreditRule {
  id                       String   @id @default(uuid())
  key                      String   @unique
  canPayBooking            Boolean  @default(true)
  canPayPlatformFees       Boolean  @default(true)
  canPayServiceFees        Boolean  @default(true)
  expires                  Boolean  @default(false)
  expiryDays               Int?     @default(365)
  canBePartiallyUsed       Boolean  @default(true)
  canCombineWithCoupons    Boolean  @default(true)
  canBeRefunded            Boolean  @default(false)
  canBecomeWithdrawableCash Boolean @default(false)
  updatedBy                String?
  updatedAt                DateTime @updatedAt
}

// ============================================================
// ADMIN RBAC — OFFERS (spec sections 7-8)
// ============================================================

model Offer {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String?
  type          String // PERCENTAGE_DISCOUNT, FIXED_AMOUNT_DISCOUNT, FIRST_BOOKING, RETURNING_USER, PARTNER_PROMOTION, SERVICE_SPECIFIC, TIME_LIMITED, CITY_SPECIFIC, REFERRAL, FESTIVAL
  discountType  String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue Float
  status        String   @default("DRAFT") // DRAFT, PREVIEW, ACTIVE, PAUSED, EXPIRED, DEACTIVATED
  startDate     DateTime?
  endDate       DateTime?
  maxUses       Int?
  usedCount     Int      @default(0)
  perUserLimit  Int?     @default(1)
  minBooking    Float    @default(0)
  maxDiscount   Float?
  serviceType   String?
  accountType   String?  // USER, PARTNER
  city          String?
  snapshot      Json?    // frozen configuration; copied onto bookings/payments
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([code])
}

// ============================================================
// ADMIN RBAC — TWO-STEP APPROVAL WORKFLOW (spec section 18)
// ============================================================

model AdminApprovalRequest {
  id               String   @id @default(uuid())
  type             String // LARGE_REFUND, LARGE_CREDIT, LARGE_PRICING_CHANGE, PERMISSION_ESCALATION, ADMIN_CREATION
  requestedById    String
  requestedByRole  String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  payload          Json?
  targetEntityType String?
  targetEntityId   String?
  reason           String?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([type])
}

// ============================================================
// ADMIN RBAC — CITY MANAGEMENT (spec section 27)
// ============================================================

model City {
  id            String   @id @default(uuid())
  key           String   @unique // CHENNAI, BANGALORE, MUMBAI, DELHI
  name          String
  state         String?
  isActive      Boolean  @default(true)
  operatingHours Json?   // { open: "06:00", close: "23:00", tz: "Asia/Kolkata" }
  taxes         Json?    // { gst: 18, sgst: 9, cess: 0 }
  config        Json?    // services, pricingRef, partnerCategory overrides
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model IdempotencyKey {
  id            String   @id @default(cuid())
  key           String   @unique
  userId        String?
  requestBody   Json?
  responseBody  Json?
  statusCode    Int?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([key])
  @@index([userId])
}

// Uploaded files (avatars, KYC documents, chat media) stored as BYTEA so they
// survive ephemeral host redeploys (Render wipes local disk). Key mirrors the
// public URL, e.g. "private/<uuid>.jpg", "chat/<uuid>.mp3", "<uuid>.png".
model UploadedFile {
  id        String   @id @default(cuid())
  key       String   @unique
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// DATING CORE
// Greenfield. Independent of the legacy Booking/Partner flow.
// ============================================================

model Like {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  type       String   @default("LIKE")
  createdAt  DateTime @default(now())

  fromUser User @relation("LikeGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("LikeReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, createdAt])
}

model Pass {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  fromUser User @relation("PassGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("PassReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Match {
  id            String    @id @default(uuid())
  userAId       String
  userBId       String
  matchedAt     DateTime  @default(now())
  lastMessageAt DateTime?
  isActive      Boolean   @default(true)

  userA User @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

// ============================================================
// SUBSCRIPTIONS
// Prices are admin-configurable here, never hardcoded in the
// frontend. Replaces the legacy one-off booking payment model.
// ============================================================

model SubscriptionPlan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  price         Float
  currency      String   @default("INR")
  durationDays  Int
  trialDays     Int      @default(0)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  // Cashfree plan_id once mirrored to the gateway; null until then.
  gatewayPlanId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, displayOrder])
}

model Subscription {
  id                   String    @id @default(uuid())
  subscriptionId       String    @unique
  userId               String
  planId               String
  // INITIALIZED | PENDING | ACTIVE | ON_HOLD | PAUSED | CUSTOMER_PAUSED
  // | COMPLETED | CUSTOMER_CANCELLED | EXPIRED | CANCELLED
  status               String    @default("INITIALIZED")
  // INITIALIZED | PENDING | SUCCESS | FAILED
  authorizationStatus  String    @default("PENDING")
  trialEndsAt          DateTime?
  nextBillingAt        DateTime?
  startedAt            DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, nextBillingAt])
}

