{
  "name": "rentbuddy-mobile",
  "version": "2.0.0",
  "private": true,
  "description": "RentBuddy 2026 React Native / Expo mobile app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-font": "~13.0.0",
    "expo-image": "~2.0.0",
    "expo-blur": "~14.0.0",
    "expo-camera": "~16.0.0",
    "expo-av": "~15.0.0",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.29.0",
    "expo-linking": "~7.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-constants": "~17.0.0",
    "expo-haptics": "~14.0.0",
    "react": "18.3.2",
    "react-native": "0.76.5",
    "react-native-screens": "~4.4.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-gesture-handler": "~2.21.0",
    "react-native-reanimated": "~3.16.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "@shopify/flash-list": "^1.7.3",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "zustand": "^5.0.1",
    "axios": "^1.7.9",
    "@react-native-firebase/app": "^21.7.0",
    "@react-native-firebase/auth": "^21.7.0",
    "@react-native-firebase/firestore": "^21.7.0",
    "@react-native-firebase/storage": "^21.7.0",
    "@react-native-firebase/messaging": "^21.7.0",
    "@react-native-firebase/crashlytics": "^21.7.0",
    "@react-native-community/netinfo": "^11.4.1",
    "react-native-maps": "^1.20.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "^15.9.0",
    "react-i18next": "^15.1.3",
    "i18next": "^23.16.4",
    "react-native-mmkv": "^3.1.0",
    "date-fns": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "@types/react-native": "~0.76.0",
    "typescript": "~5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "@testing-library/react-native": "^12.8.1",
    "babel-plugin-transform-remove-console": "^6.9.4"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@shopify/flash-list)"
    ]
  },
  "eslintConfig": {
    "extends": "expo",
    "ignorePatterns": [
      "/dist/*"
    ]
  }
}
