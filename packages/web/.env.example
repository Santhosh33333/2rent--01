# Production frontend env (set these in Vercel → Project → Settings → Environment Variables)
# Backend API base URL — your deployed backend (Render/Railway/VPS), NOT localhost.
VITE_API_BASE_URL=https://api.yourdomain.com/api
# Clerk publishable key (same as local unless you use a production Clerk app).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Cashfree needs no client-side key: the backend creates the order and returns a
# hosted checkout URL, so there is no publishable payment id to put in the bundle.
# Google OAuth client ID (public; ships in the bundle by design).
# MUST be exactly the same value as the backend's GOOGLE_CLIENT_ID (Render env),
# and this OAuth client (owned by GCP project 523643092182 -- NOTE this is NOT
# the nabri-9b94d Firebase project) must list every origin this site is served
# from under "Authorized JavaScript origins":
#   Google Cloud Console -> APIs & Services -> Credentials -> the client ending
#   in ...v5dvej.apps.googleusercontent.com
#   Origins: https://2rent-01.vercel.app  (+ the custom domain, e.g. https://yuvers.in)
# If an origin is missing, Google shows "Access blocked: Authorisation error /
# no registered origin / Error 401: invalid_client" and login never gets a token.
VITE_GOOGLE_CLIENT_ID=523643092182-auoknf0n7fg27j1h91klhs8vr6v5dvej.apps.googleusercontent.com
# TMDB key lives SERVER-side only (Render env TMDB_API_KEY) — never put it here.
# AI keys live SERVER-side only (Render env AI_API_BASE/AI_API_KEY/AI_MODEL).

# ---------------------------------------------------------------------------
# Landing page film (optional)
# ---------------------------------------------------------------------------
# The bare 11-character YouTube id of the product film shown in the landing hero.
# It is deliberately NOT defaulted to anything: with this unset the hero shows the
# WebGL phone instead of a video, because a hardcoded id would point at whatever
# happens to live at that address and present it as your product.
# It is click-to-play — no YouTube byte is requested until a visitor presses play.
# VITE_YOUTUBE_ID=dQw4w9WgXcQ

# ---------------------------------------------------------------------------
# Social channels for the site footer (optional)
# ---------------------------------------------------------------------------
# An unset channel is not rendered at all, rather than rendered as a dead link.
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/nabri
# VITE_SOCIAL_FACEBOOK=https://facebook.com/nabri
# VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/nabri
# VITE_SOCIAL_X=https://x.com/nabri
# VITE_SOCIAL_YOUTUBE=https://youtube.com/@nabri

# Google AdMob. Leave these unset to run on Google's public TEST ad units, which
# serve test ads and earn nothing -- that is the safe default before the app is
# approved for Monetisation. Set the real ids from AdMob console to earn.
# The AdMob App ID is a native value: packages/web/android/app/src/main/res/values/strings.xml (admob_app_id).
# VITE_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# VITE_ADMOB_REWARDED_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# ---------------------------------------------------------------------------
# WebRTC calls (REQUIRED for audio to work on most networks)
# ---------------------------------------------------------------------------
# Without a TURN relay, calls only connect on simple home/mobile networks.
# On symmetric NAT, corporate wifi, and carrier-grade NAT (most 4G/5G) the
# call will ring, connect, and then carry NO AUDIO, because STUN alone cannot
# find a path. A TURN relay is the fix.
# Any of these works: Cloudflare Calls TURN, Twilio, Metered, or a self-hosted
# coturn. Credentials are the short-lived ones the provider gives you.
# VITE_TURN_URL=turn:your-relay.example.com:3478
# VITE_TURN_USERNAME=nabri
# VITE_TURN_CREDENTIAL=your-shared-secret
