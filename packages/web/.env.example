# Production frontend env (set these in Vercel → Project → Settings → Environment Variables)
# Backend API base URL — your deployed backend (Render/Railway/VPS), NOT localhost.
VITE_API_BASE_URL=https://api.yourdomain.com/api
# Clerk publishable key (same as local unless you use a production Clerk app).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Razorpay key: use the LIVE key (rzp_live_...) for production.
VITE_RAZORPAY_KEY_ID=rzp_test_xxx
