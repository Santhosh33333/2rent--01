# Production frontend env (set these in Vercel → Project → Settings → Environment Variables)
# Backend API base URL — your deployed backend (Render/Railway/VPS), NOT localhost.
VITE_API_BASE_URL=https://api.yourdomain.com/api
# Clerk publishable key (same as local unless you use a production Clerk app).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Razorpay key: use the LIVE key (rzp_live_...) for production.
VITE_RAZORPAY_KEY_ID=rzp_test_xxx
# Google OAuth client ID (public; ships in the bundle by design).
VITE_GOOGLE_CLIENT_ID=523643092182-auoknf0n7fg27j1h91klhs8vr6v5dvej.apps.googleusercontent.com
# TMDB key lives SERVER-side only (Render env TMDB_API_KEY) — never put it here.
# AI keys live SERVER-side only (Render env AI_API_BASE/AI_API_KEY/AI_MODEL).

# Google AdMob. Leave these unset to run on Google's public TEST ad units, which
# serve test ads and earn nothing -- that is the safe default before the app is
# approved for Monetisation. Set the real ids from AdMob console to earn.
# The AdMob App ID is a native value: packages/web/android/app/src/main/res/values/strings.xml (admob_app_id).
# VITE_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# VITE_ADMOB_REWARDED_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
